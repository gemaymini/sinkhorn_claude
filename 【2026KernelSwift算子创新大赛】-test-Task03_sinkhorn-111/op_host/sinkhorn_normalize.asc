// ============================================================================
// Ascend C Kernel 直调样例 - SinkhornNormalize (Host + Main 入口)
// ============================================================================

// 引入定长整数类型，Host 接口使用 uint32_t、uint8_t 和 int32_t 明确 ABI 中的位宽。
#include <cstdint>
// 引入标准输出流设施；该样例当前主要用 printf，但依赖链也可使用 iostream 类型。
#include <iostream>
// 引入动态数组容器，KernelCall 用 vector 统一管理输入和输出的 Host/Device 地址。
#include <vector>
// 引入 AscendCL 运行时 API，提供设备、Stream、内存分配、拷贝和同步等 Host 能力。
#include "acl/acl.h"
// 引入 Host 与 Kernel 共享的 tiling 数据结构、问题常量和分核计算函数。
#include "../op_kernel/sinkhorn_normalize_tiling.h"
// 引入二进制文件读写辅助函数，用于装载输入张量和保存输出张量。
#include "data_utils.h"

// 把常量名包装为同名宏；宏展开期间自身会被抑制再次展开，因此最终仍引用 tiling 头中定义的 constexpr 值。
#define SN_TILE_TARGET (SN_TILE_TARGET)

// 直接包含 Ascend C Kernel 定义，使本直调样例在同一构建单元中获得可用的 Kernel 启动符号。
#include "../op_kernel/sinkhorn_normalize_kernel.asc"

// 定义一个 Host 侧参数描述符，将二进制文件路径与对应张量的字节长度绑定在一起。
struct ArgInfo {
    // 保存输入或输出文件路径，KernelCall 据此执行 ReadFile 或 WriteFile。
    std::string fileName;
    // 保存该参数缓冲区的总字节数，供 Host/Device 分配和 ACL 拷贝共同使用。
    size_t length;
// 结束 ArgInfo 聚合结构体定义，分号使该类型声明完整生效。
};

// 定义一次完整的 Kernel 直调流程：准备内存、搬运输入、发射 Kernel、取回输出并释放资源。
void KernelCall(uint32_t blockNum, aclrtStream stream,
    // inputsInfo 和 outputsInfo 描述各参数文件与大小；使用引用避免复制两个 vector。
    std::vector<ArgInfo> &inputsInfo, std::vector<ArgInfo> &outputsInfo,
    // tilingData 指向 Host 侧序列化参数，调用前必须至少包含一个完整 SinkhornTilingData 对象。
    uint8_t *tilingData)
// 进入 KernelCall 函数体；本函数按“Host 暂存区 + Device 全局内存”两级管理每个张量。
{
    // 为每个输入创建 Host 地址槽位；vector 初始化后各指针值为 nullptr。
    std::vector<uint8_t *> inputHost(inputsInfo.size());
    // 为每个输入创建 Device 地址槽位，稍后由 aclrtMalloc 填入实际 GM 地址。
    std::vector<uint8_t *> inputDevice(inputsInfo.size());
    // 为每个输出创建页锁定 Host 地址槽位，用于 D2H 拷贝后写入结果文件。
    std::vector<uint8_t *> outputHost(outputsInfo.size());
    // 为每个输出创建 Device 地址槽位，Kernel 会直接写这些全局内存缓冲区。
    std::vector<uint8_t *> outputDevice(outputsInfo.size());
    // 初始化 tiling 的 Device 指针；后续会单独分配一个结构体大小的 GM 缓冲区。
    uint8_t *tilingDevice = nullptr;

    // 在 Device 上分配 tiling 结构空间；HUGE_FIRST 表示运行时优先尝试从大页内存池分配。
    aclrtMalloc((void **)&tilingDevice, sizeof(SinkhornTilingData), ACL_MEM_MALLOC_HUGE_FIRST);
    // 把 Host 侧 tiling 结构同步复制到 Device，使每个 AI Core 都能读取分核及算法参数。
    aclrtMemcpy(tilingDevice, sizeof(SinkhornTilingData), tilingData,
        // 指定实际复制完整结构体大小，并明确传输方向为 Host 到 Device。
        sizeof(SinkhornTilingData), ACL_MEMCPY_HOST_TO_DEVICE);

    // 遍历全部输入参数；当前算子只有一个输入，但容器设计允许相同流程扩展到多输入。
    for (size_t i = 0; i < inputsInfo.size(); i++) {
        // 分配 ACL 管理的页锁定 Host 内存，提高后续 H2D DMA 搬运的稳定性和效率。
        aclrtMallocHost((void **)&inputHost[i], inputsInfo[i].length);
        // 为第 i 个输入分配等长 Device 全局内存，作为 Kernel 的实际输入地址。
        aclrtMalloc((void **)&inputDevice[i], inputsInfo[i].length, ACL_MEM_MALLOC_HUGE_FIRST);
        // 从描述符指定的二进制文件读取完整输入，写入刚分配的 Host 暂存缓冲区。
        ReadFile(inputsInfo[i].fileName, inputsInfo[i].length, inputHost[i], inputsInfo[i].length);
        // 将 Host 输入同步复制到对应 Device 缓冲区；目标容量使用同一 length 防止越界。
        aclrtMemcpy(inputDevice[i], inputsInfo[i].length, inputHost[i],
            // 实际复制 length 字节，并标记 ACL_MEMCPY_HOST_TO_DEVICE 以选择正确搬运方向。
            inputsInfo[i].length, ACL_MEMCPY_HOST_TO_DEVICE);
    // 结束输入准备循环；此时每个 inputDevice 元素都应指向已填充的 GM 缓冲区。
    }

    // 遍历全部输出参数，为 Kernel 写回和随后落盘分别准备 Device 与 Host 缓冲区。
    for (size_t i = 0; i < outputsInfo.size(); i++) {
        // 分配页锁定 Host 输出内存，稍后接收同步的 D2H 结果。
        aclrtMallocHost((void **)&outputHost[i], outputsInfo[i].length);
        // 分配 Device 输出内存；无需初始化，因为 Kernel 会覆盖所有有效输出元素。
        aclrtMalloc((void **)&outputDevice[i], outputsInfo[i].length, ACL_MEM_MALLOC_HUGE_FIRST);
    // 结束输出内存分配循环。
    }

    // 使用 Ascend C 三尖括号语法发射 Kernel：blockNum 决定并行 block 数，nullptr 表示不传额外 L2 控制参数。
    sinkhorn_normalize_kernel<<<blockNum, nullptr, stream>>>(
        // 传入第一个输入的 Device 地址；SinkhornNormalize 当前算子契约只有一个输入张量。
        inputDevice[0],
        // 传入第一个输出的 Device 地址以及 Device 侧 tiling 地址，供 Kernel 写结果和读取调度信息。
        outputDevice[0], tilingDevice);
    // 阻塞 Host 直到该 Stream 中 Kernel 等此前任务全部完成，确保下面释放 tiling 和拷贝输出是安全的。
    aclrtSynchronizeStream(stream);

    // Kernel 已完成且不会再读取 tiling，因此释放其 Device 内存。
    aclrtFree(tilingDevice);
    // 逐个处理输出：从 Device 取回、写入文件，然后释放两侧缓冲区。
    for (size_t i = 0; i < outputsInfo.size(); i++) {
        // 将第 i 个结果同步复制到 Host，目标和源容量均由同一个输出长度约束。
        aclrtMemcpy(outputHost[i], outputsInfo[i].length, outputDevice[i],
            // 复制完整输出字节数，并明确方向为 Device 到 Host。
            outputsInfo[i].length, ACL_MEMCPY_DEVICE_TO_HOST);
        // 把 Host 结果逐字节写到指定文件，作为与参考实现比较或后处理的持久化输出。
        WriteFile(outputsInfo[i].fileName, outputHost[i], outputsInfo[i].length);
        // 释放第 i 个 Device 输出缓冲区，避免直调程序结束前累积 GM 泄漏。
        aclrtFree(outputDevice[i]);
        // 释放由 aclrtMallocHost 创建的页锁定 Host 输出内存；必须与普通 free 区分。
        aclrtFreeHost(outputHost[i]);
    // 结束输出回收循环。
    }

    // 输出处理完毕后遍历输入，回收此前为每个输入分配的 Device 与 Host 资源。
    for (size_t i = 0; i < inputsInfo.size(); i++) {
        // 释放第 i 个 Device 输入缓冲区；Stream 已同步，因此 Kernel 不再访问该地址。
        aclrtFree(inputDevice[i]);
        // 释放第 i 个页锁定 Host 输入缓冲区。
        aclrtFreeHost(inputHost[i]);
    // 结束输入资源回收循环。
    }
// 结束 KernelCall；正常路径上的 tiling、输入和输出内存都已经释放。
}

// 定义独立可执行样例入口；argc 和 argv 保留标准 main ABI，当前实现不解析命令行参数。
int32_t main(int32_t argc, char *argv[])
// 进入主流程：初始化 ACL、选择设备、计算 tiling、创建 Stream、执行 Kernel 并清理运行时。
{
    // 初始化 AscendCL；传入 nullptr 表示不加载额外的 ACL 配置文件。
    aclInit(nullptr);
    // 选择逻辑设备 0 作为本样例的执行设备，后续内存与 Stream 都隶属于该设备上下文。
    int32_t deviceId = 0;
    // 激活指定 Device 并保存 ACL 状态码，只有 ACL_SUCCESS 才能继续创建其运行时资源。
    auto ret = aclrtSetDevice(deviceId);
    // 检查设备设置结果，避免在没有有效 Device 上下文时继续查询或分配资源。
    if (ret != ACL_SUCCESS) {
        // 输出底层错误码，便于根据 ACL 文档定位驱动、设备号或运行时初始化问题。
        printf("aclrtSetDevice failed, ret=%d\n", ret);
        // 将 ACL 错误码作为进程退出码返回，让调用脚本能够识别失败。
        return ret;
    // 结束设置 Device 失败分支；成功时继续查询硬件资源。
    }

    // 初始化可用 Vector Core 数量的接收变量；使用 int64_t 匹配 aclrtGetDeviceInfo 的输出类型。
    int64_t availableCoreNum = 0;
    // 查询设备的 Vector Core 个数，Host tiling 会据此限制 Kernel 的 block 并行度。
    ret = aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_VECTOR_CORE_NUM, &availableCoreNum);
    // 检查硬件属性查询是否成功，失败时不能可靠地计算分核方案。
    if (ret != ACL_SUCCESS) {
        // 打印查询失败的 ACL 错误码，便于诊断设备属性接口或上下文问题。
        printf("aclrtGetDeviceInfo failed, ret=%d\n", ret);
        // 退出前重置刚才设置的设备，释放该进程持有的 Device 运行时资源。
        aclrtResetDevice(deviceId);
        // 返回失败状态，停止进入 tiling 和 Kernel 发射阶段。
        return ret;
    // 结束硬件属性查询失败分支。
    }

    // Problem shape: 1024 4x4 matrices, repeat=10, eps=1e-6
    // 固定问题批量为 1024 个独立 4×4 矩阵，与比赛 Task03 的评测形状保持一致。
    const uint32_t totalMats = 1024;
    // 从共享常量读取 Sinkhorn 总轮数，使 Host 下发值与 Kernel 默认配置一致。
    const uint32_t repeat = SN_REPEAT;
    // 从共享常量读取分母稳定项和 softmax 后加数，保证与参考实现的 1e-6 语义一致。
    const float eps = SN_EPS;
    // 按“矩阵数 × 每矩阵元素数 × FP32 字节数”计算输入二进制和 Device 缓冲区大小。
    const size_t inputByteSize = totalMats * SN_MAT_SIZE * sizeof(float);
    // 输出形状和 dtype 与输入相同，因此所需字节数完全复用输入大小。
    const size_t outputByteSize = inputByteSize;

    // 在 Host 栈上创建 tiling 结构，随后由 SinkhornComputeTiling 填充所有调度字段。
    SinkhornTilingData tiling;
    // 根据问题规模、迭代参数、可用核数和目标 tile 大小计算分核及每核处理量。
    SinkhornComputeTiling(tiling, totalMats, repeat, eps,
                          // 将硬件返回的有符号核数转为 tiling 接口要求的 uint32_t，并传入每核目标矩阵数。
                          static_cast<uint32_t>(availableCoreNum), SN_TILE_TARGET);
    // 取出实际 block 数，作为三尖括号 Kernel launch 的并行任务数量。
    const uint32_t blockNum = tiling.blockNum;
    // 取出普通核心的矩阵配额，用于日志展示和验证负载划分。
    const uint32_t matPerCore = tiling.matPerCore;
    // 取出最后一个核心的实际矩阵数，用于观察不能整除时的尾核负载。
    const uint32_t tailMatLastCore = tiling.tailMatLastCore;

    // 打印完整调度摘要，便于核对总矩阵数、迭代参数、硬件核数、tile 和尾核是否符合预期。
    printf("SinkhornNormalize: totalMats=%u, repeat=%u, eps=%g, cores=%ld, blockNum=%u, matPerCore=%u, matsPerTile=%u, tail=%u\n",
        // 按格式串顺序传入标量；tiling.matsPerTile 是每次装入 UB 的最大矩阵批量。
        totalMats, repeat, eps, availableCoreNum, blockNum, matPerCore, tiling.matsPerTile, tailMatLastCore);

    // 构造输入参数表；聚合初始化中的路径是测试数据文件，长度必须与 1024×4×4 个 FP32 一致。
    std::vector<ArgInfo> inputsInfo = {
        // 当前算子唯一输入 x 从 ./input/input_x.bin 读取，并使用上面计算的精确字节数。
        {"./input/input_x.bin", inputByteSize}
    // 结束输入描述符 vector 的初始化列表。
    };
    // 构造输出参数表，指定结果落盘路径和与输入相同的字节长度。
    std::vector<ArgInfo> outputsInfo = {
        // 当前算子唯一输出写入 ./output/output.bin，供精度脚本读取和比对。
        {"./output/output.bin", outputByteSize}
    // 结束输出描述符 vector 的初始化列表。
    };

    // 初始化 Stream 句柄为空，避免创建前持有未定义值。
    aclrtStream stream = nullptr;
    // 在当前 Device 上创建执行 Stream；内存操作与 Kernel 将按该 Stream/同步调用的顺序完成。
    aclrtCreateStream(&stream);

    // 调用封装流程，在新建 Stream 上完成输入搬运、Kernel 执行、结果回传和文件写出。
    KernelCall(blockNum, stream, inputsInfo, outputsInfo, (uint8_t *)&tiling);

    // KernelCall 已同步完成，销毁不再需要的 Stream 运行时资源。
    aclrtDestroyStream(stream);
    // 重置设备，释放当前进程在 deviceId 上建立的运行时上下文与残余资源。
    aclrtResetDevice(deviceId);
    // 终止 AscendCL 全局运行时，与入口处的 aclInit 配对。
    aclFinalize();

    // 返回 0 表示直调样例从初始化到结果保存均走完正常控制路径。
    return 0;
// 结束 main 函数定义。
}
