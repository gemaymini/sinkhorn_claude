// 引入 AscendC 设备端编程接口，提供 GM/UB tensor、向量原语、DMA 搬运和硬件事件。
#include "kernel_operator.h"
// 引入 Host 与 Kernel 共享的 tiling 结构及矩阵尺寸、tile 上限等编译期常量。
#include "sinkhorn_normalize_tiling.h"

// 把 AscendC 类型和函数引入当前作用域，使后续原语调用不必重复写命名空间前缀。
using namespace AscendC;


// 匿名命名空间让辅助常量只在本编译单元可见，避免跨文件符号冲突。
namespace {
// 一个 32B 数据块可容纳 8 个 FP32；UB 中每个 padded 行正好占一个 block。
constexpr uint32_t BLK = 8;             
// GM 中一行只有 4 个 FP32，因此单行有效搬运长度为 16B。
constexpr uint32_t ROW_BYTES = SN_MHC * sizeof(float);

// 给输入加 900 后可把正常有效值与 -1000 padding 分开，用算术生成有效位掩码。
constexpr float SN_MASK_BIAS = 900.0f;
// 结束匿名命名空间，BLK 与 SN_MASK_BIAS 不导出到其他编译单元。
}

// 该类封装单个 AIV 核负责的 GM 子区间、UB 工作区和完整 Sinkhorn 数据流。
class KernelSinkhornS1 {
// 公开区放置构造、初始化和主入口，供全局 Kernel 函数创建并驱动实例。
public:
    // 构造时仅保存 TPipe 指针；TPipe 统一管理 UB 分配以及跨流水线事件。
    __aicore__ inline KernelSinkhornS1(TPipe *pipe) : pipe_(pipe) {}

    // Init 接收输入/输出/tiling 的 GM 地址，并开始声明设备侧初始化接口。
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR tiling,
                                // 强类型 __gm__ 指针让设备端按共享结构读取 Host 写入的 tiling 字段。
                                const __gm__ SinkhornTilingData *t)
    // 进入初始化阶段；这里只建立参数、地址视图和 UB 缓冲，不做矩阵运算。
    {
        // 读取总迭代轮数：首轮含 softmax 与列归一化，余下轮次执行行列交替归一化。
        repeat_ = t->repeat;
        // 读取本次调用的 eps，保证自定义 Kernel 与参考实现采用同一稳定项。
        eps_ = t->eps;
        // 列和里填充列恒为 0，除数必须非零；eps 若为 0 则退回一个极小量
        // eps_<=SN_TINY 时所有列改用极小正数；真实正列和的变化可忽略，同时避免 padding 列发生 0/0。
        colEps_ = eps_ > SN_TINY ? eps_ : SN_TINY;
        // 读取每次装入 UB 的矩阵数，Process 将以此为步长遍历本核任务。
        tile_ = t->matsPerTile;
        // 检查 tile 是否为 0 或超过静态 UB 容量，防止死循环及缓冲区越界。
        if (tile_ == 0 || tile_ > SN_TILE_MAX) {
            // 非法 tile 回退为 SN_TILE_MAX，从而得到可推进且容量安全的批大小。
            tile_ = SN_TILE_MAX;
        // 结束 tile 参数的防御性修正分支。
        }

        // 取得当前 block/AIV 核编号，用于把矩阵集合切分为互不重叠的并行区间。
        const uint32_t blockIdx = GetBlockIdx();
        // 读取普通核的矩阵跨度，设备侧以相同跨度计算每个 block 的起止位置。
        const uint32_t matPerCore = t->matPerCore;
        // 当前核的全局矩阵起点等于 block 编号乘每核跨度，单位是矩阵而非元素。
        matStart_ = blockIdx * matPerCore;
        // 先按完整跨度计算右开区间终点，尾核将在下一步钳制到真实总数。
        matEnd_ = matStart_ + matPerCore;
        // 判断理论终点是否越过输入中实际存在的矩阵数量。
        if (matEnd_ > t->totalMats) {
            // 把尾核终点限制到 totalMats，杜绝 GM 越界读写。
            matEnd_ = t->totalMats;
        // 结束尾核终点修正。
        }
        // 额外防御 launch blockDim 与 tiling 不一致造成的起点越界。
        if (matStart_ > t->totalMats) {
            // 越界 block 被钳制为空区间，使后续 Process 自然不执行。
            matStart_ = t->totalMats;
        // 结束起点边界修正。
        }

        // 计算本核真实矩阵数，最后一个核可能少于 matPerCore。
        const uint32_t myMats = matEnd_ - matStart_;
        // 建立输入 GM 局部视图：跳过 matStart_×16 个元素，并限制长度为 myMats×16。
        xGm.SetGlobalBuffer((__gm__ float *)x + matStart_ * SN_MAT_SIZE, myMats * SN_MAT_SIZE);
        // 建立相同范围的输出 GM 视图，使 matOff 可统一作为核内相对矩阵偏移。
        yGm.SetGlobalBuffer((__gm__ float *)y + matStart_ * SN_MAT_SIZE, myMats * SN_MAT_SIZE);


        // 分配主 UB，最多保存 128 个 padded 矩阵，每矩阵 32 个 FP32，共 16KiB。
        pipe_->InitBuffer(zBuf, SN_TILE_MAX * SN_PAD_MAT * sizeof(float));
        // 分配广播 UB，用于把每行的 max 或 sum 扩展回完整 8-lane 行。
        pipe_->InitBuffer(bcastBuf, SN_TILE_MAX * SN_PAD_MAT * sizeof(float));
        // 分配 eps 掩码 UB，其有效四列为 eps、padding 四列为 0。
        pipe_->InitBuffer(epsBuf, SN_TILE_MAX * SN_PAD_MAT * sizeof(float));
        // 分配行归约 UB，每个矩阵需要保存 4 个行最大值或行和。
        pipe_->InitBuffer(rowBuf, SN_TILE_MAX * SN_MHC * sizeof(float));
        // 分配列归约 UB，每矩阵用完整 8-lane block 保存四个真实列和及四个零列和。
        pipe_->InitBuffer(colBuf, SN_TILE_MAX * BLK * sizeof(float));
        // 以上五块 UB 已覆盖主数据、广播、eps 掩码、行归约和列归约；

    // 结束 Init；本核的 GM 窗口和所有 VECCALC UB 工作区已经就绪。
    }

    // 该函数利用 padding 哨兵现场生成有效位 eps 向量，省去常量 GM 搬运。
    __aicore__ inline void BuildEpsVectorArith(LocalTensor<float> &z, uint32_t nE)
    // 进入 eps 掩码构造；要得到精确 1/0 掩码，真实输入需满足 x+900>=1（即 x>=-899），而 -1000 padding 加后仍为负。
    {
        // 取得 epsBuf 的 FP32 LocalTensor 视图，后续四个原语全部在 UB 中执行。
        LocalTensor<float> m = epsBuf.Get<float>();
        // 计算当前补齐 tile 的总 lane 数：每个 padded 矩阵固定占 32 个 FP32。
        const uint32_t cnt = nE * SN_PAD_MAT;
        // 逐元素加 900；在 x>=-899 的特化输入前提下有效位至少为 1，padding 则从 -1000 变为 -100。
        Adds<float>(m, z, SN_MASK_BIAS, cnt);
        // 与 0 取最大值，将 padding 截为 0，同时保留有效位置的正值。
        Maxs<float>(m, m, 0.0f, cnt);
        // 与 1 取最小值，把所有有效位置饱和为 1，形成 1/0 有效位掩码。
        Mins<float>(m, m, 1.0f, cnt);
        // 掩码乘 eps，得到每行 [eps,eps,eps,eps,0,0,0,0] 的向量。
        Muls<float>(m, m, eps_, cnt);
    // 结束构造；z 保持原样，结果留在 epsBuf 供 softmax 后一次性相加。
    }


    // Process 是每个 AIV block 的主调度入口，负责遍历该核的所有 tile。
    __aicore__ inline void Process()
    // 进入调度体；空核的 myMats 为 0，循环会自然跳过。
    {
        // 由右开区间计算本核真实工作量，尾核可小于普通核。
        const uint32_t myMats = matEnd_ - matStart_;
        // 以 tile_ 为步长批处理矩阵；off 是相对于本核 GM 视图起点的矩阵偏移。
        for (uint32_t off = 0; off < myMats; off += tile_) {
            // 先取从 off 到本核末尾的剩余矩阵数，尾 tile 会保留这个较小值。
            uint32_t n = myMats - off;
            // 非尾 tile 的剩余量会超过 tile_，因此需要限制批大小。
            if (n > tile_) {
                // 把当前真实矩阵数截为 tile_，保证单次 UB 用量不超过初始化容量。
                n = tile_;
            // 结束当前 tile 大小钳制。
            }
            // 对当前 n 个矩阵执行一次完整的搬入、融合计算和写回。
            ProcessTile(off, n);
        // 结束本核 tile 循环；跨流水线事件保证下一轮可安全复用同一 UB。
        }
    // 结束 Process，本核负责的所有结果均已提交到输出 GM。
    }

// 以下实现细节仅供类内部调用，外部入口只需要 Init 和 Process。
private:

    // ProcessTile 融合一个 tile 的全部数学步骤；matOff 定位 GM，n 表示真实矩阵数。
    __aicore__ inline void ProcessTile(uint32_t matOff, uint32_t n)
    // 进入 tile 计算，所有中间结果均保留在 UB 中以避免反复访问 GM。
    {
        // 取得主 zBuf 的 LocalTensor 视图，softmax 与 Sinkhorn 都将原地覆盖它。
        LocalTensor<float> z = zBuf.Get<float>();

        // 对齐到 8 的倍数：BlockReduceSum 需要偶数，宽 ColNormalize 需要 8 的倍数。
        // SN_TILE_MAX 是 8 的倍数，所以向上取整不会越过缓冲区。
        // 将矩阵数向上补齐为 8 的倍数，以满足列原语每 repeat 并行处理 8 个矩阵的布局。
        const uint32_t nE = (n + 7U) & ~7U;

        // 把 n 个紧凑 4×4 矩阵搬入 UB，并把每行右侧四个 lane 填成 -1000。
        CopyIn(z, matOff, n);


        // 判断尾 tile 是否需要额外的虚拟矩阵来凑足 8 的倍数。
        if (nE > n) {
            // 尾部补齐的那些矩阵填 0，Exp 后为 1，全程保持有限，且不会被写回
            // 把 nE-n 个虚拟矩阵清零；它们参与向量指令但不跨矩阵归约，也不会写回 GM。
            Duplicate<float>(z[n * SN_PAD_MAT], 0.0f, (nE - n) * SN_PAD_MAT);
        // 结束虚拟尾矩阵初始化分支。
        }

        // 趁 z 还是「填充位 = SN_PAD_FILL、有效位 = x」的状态，把 eps 向量算出来
        // 在 z 仍保留有效输入与 -1000 padding 的可区分状态时构造 eps 有效位向量。
        BuildEpsVectorArith(z, nE);

        // 减去行最大值：填充位是 -1000，永远不会成为最大值；减完仍远小于 -100，
        // exp 后依旧是精确的 0。
        // 开启局部作用域执行稳定 softmax 的行最大值归约、广播与相减。
        {
            // rowMax 复用 rowBuf，连续保存全部 4×nE 个 padded 行的最大值。
            LocalTensor<float> rowMax = rowBuf.Get<float>();
            // bcast 复用大缓冲，将每个行最大值扩展成对应的 8-lane 除数/减数行。
            LocalTensor<float> bcast = bcastBuf.Get<float>();
            // 每 repeat 读取 64 lane=8 block 并分别求最大值；4nE 行需要 (4nE)/8=nE/2 个 repeat。
            BlockReduceMax<float>(rowMax, z, static_cast<uint8_t>(nE / 2), 64, 1, 1, BLK);
            // Brcb 把连续 8 个行最大值各自广播成一个 block；{1,8} 控制源值和目标 block 的推进。
            Brcb<float>(bcast, rowMax, static_cast<uint8_t>(nE / 2), {1, BLK});
            // 全部 lane 原地减行最大值，使有效指数输入不大于 0，而 padding 仍极负。
            Sub<float>(z, z, bcast, nE * SN_PAD_MAT);
        // 结束最大值临时作用域；底层 rowBuf 与 bcastBuf 仍可在后续步骤复用。
        }

        // 填充位 = exp(很负) = 0（精确），此后 10 次迭代中恒为 0
        // 对减最大值后的 z 取指数；有效位在 (0,1]，极负 padding 下溢为精确 0。
        Exp<float>(z, z, nE * SN_PAD_MAT);

        // 第一次 RowNormalize 就是 softmax（分母不带 eps，与参考实现一致）
        // 用 denomEps=0 的行归一化完成 softmax，严格匹配 softmax 分母不额外加 eps 的语义。
        RowNormalize(z, nE, 0.0f);

        // x = softmax(x) + eps —— 只加在有效位，填充位加 0 仍为 0
        // 开启短作用域读取先前生成的 eps 掩码。
        {
            // 取得 epsBuf 视图；真实行前四 lane 为 eps，padding lane 为 0。
            LocalTensor<float> epsPad = epsBuf.Get<float>();
            // 逐元素实现 softmax(x)+eps，只抬高真实概率，padding 仍保持 0。
            Add<float>(z, z, epsPad, nE * SN_PAD_MAT);
        // 结束 epsPad 作用域；该缓冲在本 tile 后续不再使用。
        }

        // 执行 softmax+eps 后的第一次列归一化，对应参考实现循环之前的单独列缩放。
        ColNormalize(z, nE);
        // 从 it=1 开始执行剩余 repeat_-1 轮，因为第 0 轮的列归一化已在上一行完成。
        for (uint32_t it = 1; it < repeat_; it++) {
            // 按 row_sum+eps_ 做行缩放，逐步把各行和拉回 1。
            RowNormalize(z, nE, eps_);
            // 紧接着按 col_sum+eps_ 做列缩放，形成一次完整 Sinkhorn 交替迭代。
            ColNormalize(z, nE);
        // 结束剩余 Sinkhorn 轮次循环。
        }

        // 仅把 n 个真实矩阵的有效四列从 padded UB 写回紧凑输出 GM。
        CopyOut(z, matOff, n);
    // 结束 ProcessTile；虚拟矩阵及每行右侧 padding 均不会出现在输出中。
    }

    // CopyIn 用 MTE2 将紧凑 GM 行扩展搬到 32B 对齐的 padded UB 行。
    __aicore__ inline void CopyIn(LocalTensor<float> &z, uint32_t matOff, uint32_t n)
    // 进入 GM→UB 搬运阶段。
    {
        // 创建扩展 DMA 描述符，后续字段描述二维小块搬运。
        DataCopyExtParams params;
        // 每个矩阵有 4 行，因此 blockCount=n×4；每个逻辑块对应一行。
        params.blockCount = static_cast<uint16_t>(n * SN_MHC);
        // 每个源块只读取 4 个 FP32，即 16B 有效行数据。
        params.blockLen = static_cast<uint32_t>(ROW_BYTES);
        // 输入 GM 行紧密相邻，所以相邻源块之间无需跳过额外字节。
        params.srcStride = 0;
        // 目标 padding 由 DataCopyPad 参数生成，扩展描述符本身不增加目标间隔。
        params.dstStride = 0;
        // 开启右侧填充：左补 0、右补 4 个 FP32，并用 -1000 填满，从而让每行占满 32B block。
        DataCopyPadExtParams<float> pad{true, 0, SN_MHC, SN_PAD_FILL};
        // 从本核 GM 视图第 matOff 个矩阵开始搬运，生成 padded-AoS 的 z 布局。
        DataCopyPad(z, xGm[matOff * SN_MAT_SIZE], params, pad);

        // MTE2 完成写 UB 后设置 MTE2→V 事件，建立 DMA 生产者到向量消费者的依赖。
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
        // 向量流水线等待同一事件，避免在 CopyIn 尚未结束时读取 z。
        WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
    // 结束 CopyIn；返回时真实 tile 数据已对向量流水线可见。
    }

    // RowNormalize 批量处理 nE 个矩阵的所有行，denomEps 控制分母是否加稳定项。
    __aicore__ inline void RowNormalize(LocalTensor<float> &z, uint32_t nE, float denomEps)
    // 进入行归一化，所有操作都在 VECCALC UB 中完成。
    {
        // rowSum 视图连续保存每矩阵 4 个行和，共 4nE 个标量。
        LocalTensor<float> rowSum = rowBuf.Get<float>();
        // bcast 保存把每个行和复制到相应 8-lane 行后的完整分母向量。
        LocalTensor<float> bcast = bcastBuf.Get<float>();

        // nE*32 个 float = nE/2 个 repeat，每 repeat 出 8 个和，连续写入
        // BlockReduceSum 每 repeat 对 8 个 block 独立求和；padding 为 0，所以结果正好是四个有效元素之和。
        BlockReduceSum<float>(rowSum, z, static_cast<uint8_t>(nE / 2), 64, 1, 1, BLK);

        // 参考实现是 x / (rowsum + eps)；softmax 那一次传 0
        // 给 4nE 个行和加 denomEps；softmax 传 0，后续 Sinkhorn 行缩放传 eps_。
        Adds<float>(rowSum, rowSum, denomEps, nE * SN_MHC);

        // Brcb 将每个行和广播回对应 block，{1,8} 表示连续读标量、按 8-lane block 写结果。
        Brcb<float>(bcast, rowSum, static_cast<uint8_t>(nE / 2), {1, BLK});
        // z 原地除以广播分母；真实四列完成归一化，零 padding 除以正数后仍为 0。
        Div<float>(z, z, bcast, nE * SN_PAD_MAT);
    // 结束 RowNormalize，结果继续留在 zBuf，未产生 GM 往返。
    }

    // ColNormalize 借助 block stride 逻辑访问同列，避免显式转置 padded-AoS 数据。
    __aicore__ inline void ColNormalize(LocalTensor<float> &z, uint32_t nE)
    // 进入列归一化；nE 已被补齐到 8 的倍数。
    {
        // colSum 每矩阵占 8 lane，前四项是列和，后四项对应恒零 padding 列。
        LocalTensor<float> colSum = colBuf.Get<float>();

        // 一个 repeat 吃 8 个矩阵：mask=64 覆盖 8 个 block，blkStride=4 让这 8 个 block
        // 落在矩阵 8j+0..8j+7 的同一行上；repStride=32 每个 repeat 跨过 8 个矩阵。
        // 64-lane mask 让每个 repeat 激活 8 个 8-lane block，也就是同一行的 8 个矩阵。
        const uint64_t cmask = 64;
        // 每 repeat 覆盖 8 个矩阵，因此 nE 个矩阵需要 nE/8 次 repeat。
        const uint8_t crep = static_cast<uint8_t>(nE / 8);
        // pSum0 的 block stride 让源跨 4 block 取下一矩阵同一行，目的连续写列和；repeat stride 跨过 8 个矩阵。
        const BinaryRepeatParams pSum0{1, 4, 4, 8, 32, 32};   // colSum = z[r0] + z[r1]
        // pSum1 令连续 colSum 与跨 4 block 的下一行相加，repeat 后分别跨 8 和 32 block。
        const BinaryRepeatParams pSum1{1, 1, 4, 8, 8, 32};    // 两次调用分别执行 colSum += z[r2] 与 colSum += z[r3]
        // pApply 让 z 的目的/源均跨 4 block选同一行，让 colSum 连续跨 1 block提供每矩阵除数。
        const BinaryRepeatParams pApply{4, 4, 1, 32, 32, 8};  // z[rk] /= colSum

        // colSum[8m..8m+8) = z[32m..] + z[32m+8..] + z[32m+16..] + z[32m+24..]
        // 先把每个矩阵 r0 与 r1 的 8-lane 向量相加，结果连续写入 colSum。
        Add<float>(colSum, z, z[BLK], cmask, crep, pSum0);
        // 在已有部分列和上累加 r2；BLK×2 是 r2 相对 r0 的两个 block 偏移。
        Add<float>(colSum, colSum, z[BLK * 2], cmask, crep, pSum1);
        // 再累加 r3，至此每个 colSum block 等于该矩阵四行逐 lane 求和。
        Add<float>(colSum, colSum, z[BLK * 3], cmask, crep, pSum1);

        // 参考实现是 x / (colsum + eps)。填充列的和恒为 0，加 eps 后得到有限正分母，
        // 恒为 0 的填充值除以该分母仍是 0，不会产生 inf/NaN。
        // 所有列和加 colEps_；真实列匹配参考分母，padding 列得到非零分母以杜绝 0/0。
        Adds<float>(colSum, colSum, colEps_, nE * BLK);

        // 同一个列向量作用到 4 个行组
        // 依次把同一个列和向量应用到矩阵的四个行组。
        for (uint32_t r = 0; r < SN_MHC; r++) {
            // 第 r 行逐 lane 除以对应列和；pApply 同时覆盖每组 8 个矩阵。
            Div<float>(z[BLK * r], z[BLK * r], colSum, cmask, crep, pApply);
        // 结束四行列除法循环。
        }
    // 结束 ColNormalize；布局未改变，可直接进入下一轮行归一化。
    }

    // CopyOut 用 MTE3 把 padded UB 的有效四列压回紧凑 GM。
    __aicore__ inline void CopyOut(LocalTensor<float> &z, uint32_t matOff, uint32_t n)
    // 进入 UB→GM 写回阶段。
    {
        // 设置 V→MTE3 事件，声明最后一次向量 Div 已完成对 z 的写入。
        SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
        // MTE3 等待该事件，防止把尚未计算完成的数据提前写到 GM。
        WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);

        // 批量：n*4 个 block，每个取前 16B
        // 创建写回用扩展 DMA 描述符。
        DataCopyExtParams params;
        // 只写 n 个真实矩阵的 4n 行，补齐的虚拟矩阵不包含在 blockCount 中。
        params.blockCount = static_cast<uint16_t>(n * SN_MHC);
        // 每行只输出前四个 FP32，即 16B；右侧四个 padding lane 被舍弃。
        params.blockLen = static_cast<uint32_t>(ROW_BYTES);
        // padded UB 行按接口期望连续消费，因此描述符无需额外源间隔。
        params.srcStride = 0;
        // 目标 GM 中相邻 4-float 行紧密排列，因此目标间隔为 0。
        params.dstStride = 0;
        // 把 z 的每行有效 16B 写到本核输出视图第 matOff 个矩阵开始的位置。
        DataCopyPad(yGm[matOff * SN_MAT_SIZE], z, params);

        // 设置 MTE3→MTE2 事件，声明当前写回结束后 zBuf 才可被下一 tile 的 CopyIn 覆盖。
        SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
        // 等待写回完成再返回；单缓冲设计依靠此依赖避免相邻 tile 读写踩踏。
        WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
    // 结束 CopyOut，当前 n 个真实矩阵结果已提交到 GM。
    }

// 以下成员保存每个 Kernel 实例独有的运行状态和内存视图。
private:
    // 保存入口函数创建的 TPipe 地址，其生命周期覆盖 Init 与 Process。
    TPipe *pipe_;
    // 迭代次数先取编译期默认值，Init 时由本次 tiling 覆盖。
    uint32_t repeat_ = SN_REPEAT;
    // eps 先取 1e-6 默认值，Init 后代表本次调用的真实稳定项。
    float eps_ = SN_EPS;
    // 列分母稳定项保证 padding 列为有限除数，通常与 eps_ 相同。
    float colEps_ = SN_EPS;
    // tile 默认采用最大 UB 容量，Init 会读取并校验 Host 建议值。
    uint32_t tile_ = SN_TILE_MAX;
    // 本核全局矩阵右开区间的起点。
    uint32_t matStart_ = 0;
    // 本核全局矩阵右开区间的终点，尾核会被钳制到 totalMats。
    uint32_t matEnd_ = 0;

    // 输入 GlobalTensor 仅映射本核负责的连续 GM 子区间。
    GlobalTensor<float> xGm;
    // 输出 GlobalTensor 采用相同核内索引基准，便于按 matOff 访问。
    GlobalTensor<float> yGm;

    // 主 VECCALC UB 缓冲保存 padded 输入及所有原地计算结果。
    TBuf<TPosition::VECCALC> zBuf;
    // 广播 UB 保存行最大值或行和的 8-lane 展开结果。
    TBuf<TPosition::VECCALC> bcastBuf;
    // eps UB 保存由 padding 哨兵算出的有效位 eps 掩码。
    TBuf<TPosition::VECCALC> epsBuf;
    // 行归约 UB 保存每个 padded 行的 max 或 sum 标量。
    TBuf<TPosition::VECCALC> rowBuf;
    // 列归约 UB 保存每个矩阵的 8-lane 列和向量。
    TBuf<TPosition::VECCALC> colBuf;
// 结束 KernelSinkhornS1 类型定义。
};

// 导出不经 C++ 名字改编的 vector-core Kernel 入口，Host launch 按该符号调用。
extern "C" __global__ __vector__ void sinkhorn_normalize_kernel(
    // 入口的 x/y 是输入输出 GM 地址，tiling 是设备侧只读控制数据地址。
    GM_ADDR x, GM_ADDR y, GM_ADDR tiling)
// 进入每个并行 block 的设备函数体。
{
    // 创建本 block 的 TPipe，负责 UB 分配和硬件事件管理。
    TPipe pipe;
    // 创建核内算子实例并关联上述 TPipe。
    KernelSinkhornS1 op(&pipe);
    // 把 tiling 地址转成共享结构指针，初始化当前 block 的区间和工作缓冲。
    op.Init(x, y, tiling, (__gm__ SinkhornTilingData *)tiling);
    // 运行该 block 的全部 tile 与 Sinkhorn 迭代。
    op.Process();
// 结束设备入口；该 block 的输出区间已经写回 GM。
}
