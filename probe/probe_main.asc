/**
 * 探针 host 入口：直调 probe_kernel 拿布局，再跑 probe_gather_cost 量成本。
 */

#include <cstdint>
#include <cstdio>
#include <chrono>
#include <vector>
#include "acl/acl.h"
#include "probe_tiling.h"
#include "probe_kernel.asc"

static void WriteBin(const char *path, const void *data, size_t bytes)
{
    FILE *f = fopen(path, "wb");
    if (!f) { printf("无法写入 %s\n", path); return; }
    fwrite(data, 1, bytes, f);
    fclose(f);
}

int32_t main()
{
    aclInit(nullptr);
    if (aclrtSetDevice(0) != ACL_SUCCESS) { printf("aclrtSetDevice 失败\n"); return 1; }
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    // ================= 第一部分：布局探针 =================
    const size_t inN = 512, outN = 512;
    std::vector<float> hostIn(inN);
    for (size_t i = 0; i < inN; i++) hostIn[i] = static_cast<float>(i);

    void *devIn = nullptr, *devOut = nullptr;
    aclrtMalloc(&devIn, inN * sizeof(float), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(&devOut, outN * sizeof(float), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(devIn, inN * sizeof(float), hostIn.data(), inN * sizeof(float),
                ACL_MEMCPY_HOST_TO_DEVICE);

    probe_kernel<<<1, nullptr, stream>>>((uint8_t *)devIn, (uint8_t *)devOut);
    if (aclrtSynchronizeStream(stream) != ACL_SUCCESS) {
        printf("probe_kernel 执行失败\n");
        return 1;
    }

    std::vector<float> hostOut(outN);
    aclrtMemcpy(hostOut.data(), outN * sizeof(float), devOut, outN * sizeof(float),
                ACL_MEMCPY_DEVICE_TO_HOST);
    WriteBin("probe_layout.bin", hostOut.data(), outN * sizeof(float));
    printf("布局探针完成 -> probe_layout.bin\n");

    // ================= 第二部分：抽平面的成本 =================
    // 用 rounds=1 和 rounds=R 各测一次，差分掉 launch 开销
    const uint32_t nMats = 64;                 // 单核处理 64 个矩阵
    const size_t gN = nMats * PR_MAT;
    std::vector<float> gIn(gN);
    for (size_t i = 0; i < gN; i++) gIn[i] = static_cast<float>(i % 97) * 0.01f;

    void *gDevIn = nullptr, *gDevOut = nullptr;
    aclrtMalloc(&gDevIn, gN * sizeof(float), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(&gDevOut, gN * sizeof(float), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(gDevIn, gN * sizeof(float), gIn.data(), gN * sizeof(float),
                ACL_MEMCPY_HOST_TO_DEVICE);

    auto timeIt = [&](uint32_t rounds, int iters) -> double {
        // 预热
        probe_gather_cost<<<1, nullptr, stream>>>(
            (uint8_t *)gDevIn, (uint8_t *)gDevOut, nMats, rounds);
        aclrtSynchronizeStream(stream);
        auto t0 = std::chrono::high_resolution_clock::now();
        for (int i = 0; i < iters; i++) {
            probe_gather_cost<<<1, nullptr, stream>>>(
                (uint8_t *)gDevIn, (uint8_t *)gDevOut, nMats, rounds);
        }
        aclrtSynchronizeStream(stream);
        auto t1 = std::chrono::high_resolution_clock::now();
        return std::chrono::duration<double, std::micro>(t1 - t0).count() / iters;
    };

    const uint32_t R = 101;
    double t1r = timeIt(1, 50);
    double tRr = timeIt(R, 50);
    double perRound = (tRr - t1r) / (R - 1);

    printf("\n=============== 抽平面成本 (nMats=%u) ===============\n", nMats);
    printf("  rounds=1   : %8.2f us\n", t1r);
    printf("  rounds=%-4u: %8.2f us\n", R, tRr);
    printf("  单轮成本   : %8.3f us   <- 16 次 strided DataCopyPad 抽满 16 个平面\n", perRound);
    printf("  折算每矩阵 : %8.4f us\n", perRound / nMats);
    printf("  外推 1024 矩阵单核: %8.2f us\n", perRound / nMats * 1024);
    printf("=====================================================\n");

    aclrtFree(devIn); aclrtFree(devOut);
    aclrtFree(gDevIn); aclrtFree(gDevOut);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return 0;
}
