/**
 * S1 前置 API 探针 —— 一次性确定几个决定 S1 结构的 AscendC 行为。
 *
 * 输入 GM: 512 个 float，值 = 下标（即 matrix m 的第 k 个元素 = 16m + k）
 * 输出 GM: 8 个 slot × 64 float，每个 slot 存一个探针的 UB 结果
 *
 * 探针清单：
 *   S0  DataCopyPad blockLen=4B  (1 float)  srcStride=60B  —— 抽"平面"：UB 侧紧凑还是补齐 32B？
 *   S1  DataCopyPad blockLen=16B (4 float)  srcStride=48B  —— 抽"行"
 *   S2  DataCopyPad blockCount=4 blockLen=16B rightPad=4   —— 一次调用能否展开 4 行到 4×8
 *   S3  BlockReduceSum(0..63)                              —— 结果落在哪些位置
 *   S4  Brcb(0..7)                                         —— 广播布局
 *   S5  PairReduceSum(0..63)                               —— 相邻两两求和的布局
 *   S6  Reciprocal(1..64)                                  —— 基本可用性
 */

#include "kernel_operator.h"
#include "probe_tiling.h"

using namespace AscendC;

constexpr uint32_t PR_SLOT = 64;          // 每个 slot 64 个 float
constexpr uint32_t PR_NSLOT = 8;
constexpr uint32_t PR_OUT = PR_SLOT * PR_NSLOT;
constexpr uint32_t PR_IN = 512;

class KernelProbe {
public:
    __aicore__ inline KernelProbe(TPipe *pipe) : pipe_(pipe) {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y)
    {
        xGm.SetGlobalBuffer((__gm__ float *)x, PR_IN);
        yGm.SetGlobalBuffer((__gm__ float *)y, PR_OUT);
        pipe_->InitBuffer(bufA, PR_SLOT * sizeof(float));
        pipe_->InitBuffer(bufB, PR_SLOT * sizeof(float));
        pipe_->InitBuffer(bufOut, PR_OUT * sizeof(float));
    }

    __aicore__ inline void Process()
    {
        LocalTensor<float> a = bufA.Get<float>();
        LocalTensor<float> b = bufB.Get<float>();
        LocalTensor<float> out = bufOut.Get<float>();

        // 全部初始化成 -999，便于识别"没被写过"的位置
        Duplicate<float>(out, -999.0f, PR_OUT);
        PipeBarrier<PIPE_V>();

        // ---- S0: 抽平面。blockCount=8, blockLen=4B, srcStride=60B ----
        // 期望（若紧凑打包）: 0, 16, 32, 48, 64, 80, 96, 112
        // 期望（若每块补 32B）: 位置 0,8,16,24,... 上是 0,16,32,48,...
        Duplicate<float>(a, -999.0f, PR_SLOT);
        PipeBarrier<PIPE_V>();
        {
            DataCopyExtParams p{8, static_cast<uint32_t>(sizeof(float)),
                                static_cast<uint32_t>(15 * sizeof(float)), 0, 0};
            DataCopyPadExtParams<float> pad{false, 0, 0, 0.0f};
            DataCopyPad(a, xGm, p, pad);
        }
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
        WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
        DataCopy(out[0 * PR_SLOT], a, PR_SLOT);
        PipeBarrier<PIPE_V>();

        // ---- S1: 抽行。blockCount=8, blockLen=16B, srcStride=48B ----
        // 期望（紧凑）: 0,1,2,3, 16,17,18,19, 32,33,34,35, ...
        Duplicate<float>(a, -999.0f, PR_SLOT);
        PipeBarrier<PIPE_V>();
        {
            DataCopyExtParams p{8, static_cast<uint32_t>(4 * sizeof(float)),
                                static_cast<uint32_t>(12 * sizeof(float)), 0, 0};
            DataCopyPadExtParams<float> pad{false, 0, 0, 0.0f};
            DataCopyPad(a, xGm, p, pad);
        }
        SetFlag<HardEvent::MTE2_V>(EVENT_ID1);
        WaitFlag<HardEvent::MTE2_V>(EVENT_ID1);
        DataCopy(out[1 * PR_SLOT], a, PR_SLOT);
        PipeBarrier<PIPE_V>();

        // ---- S2: 一次调用展开 4 行 -> 4 组 8（右补 4 个 0）----
        // 期望: 0,1,2,3,0,0,0,0, 4,5,6,7,0,0,0,0, 8,9,10,11,0,0,0,0, 12,...
        Duplicate<float>(a, -999.0f, PR_SLOT);
        PipeBarrier<PIPE_V>();
        {
            DataCopyExtParams p{4, static_cast<uint32_t>(4 * sizeof(float)), 0, 0, 0};
            DataCopyPadExtParams<float> pad{true, 0, 4, 0.0f};
            DataCopyPad(a, xGm, p, pad);
        }
        SetFlag<HardEvent::MTE2_V>(EVENT_ID2);
        WaitFlag<HardEvent::MTE2_V>(EVENT_ID2);
        DataCopy(out[2 * PR_SLOT], a, PR_SLOT);
        PipeBarrier<PIPE_V>();

        // ---- 准备 0..63 供归约类探针使用 ----
        DataCopy(a, xGm, PR_SLOT);
        SetFlag<HardEvent::MTE2_V>(EVENT_ID3);
        WaitFlag<HardEvent::MTE2_V>(EVENT_ID3);

        // ---- S3: BlockReduceSum。每 8 个一组求和 ----
        // 期望的 8 个和: 28, 92, 156, 220, 284, 348, 412, 476
        Duplicate<float>(b, -999.0f, PR_SLOT);
        PipeBarrier<PIPE_V>();
        BlockReduceSum<float>(b, a, 1, 64, 1, 1, 8);
        PipeBarrier<PIPE_V>();
        DataCopy(out[3 * PR_SLOT], b, PR_SLOT);
        PipeBarrier<PIPE_V>();

        // ---- S4: Brcb。输入取 a[0..7] = 0..7 ----
        // 期望: 第 j 个 block 的 8 个 lane 全是 j
        Duplicate<float>(b, -999.0f, PR_SLOT);
        PipeBarrier<PIPE_V>();
        Brcb<float>(b, a, 1, {1, 8});
        PipeBarrier<PIPE_V>();
        DataCopy(out[4 * PR_SLOT], b, PR_SLOT);
        PipeBarrier<PIPE_V>();

        // ---- S5: PairReduceSum。相邻两两求和 ----
        // 期望的 32 个值: 1, 5, 9, 13, ... (dst[i] = 4i+1)
        Duplicate<float>(b, -999.0f, PR_SLOT);
        PipeBarrier<PIPE_V>();
        PairReduceSum<float>(b, a, 1, 64, 1, 1, 8);
        PipeBarrier<PIPE_V>();
        DataCopy(out[5 * PR_SLOT], b, PR_SLOT);
        PipeBarrier<PIPE_V>();

        // ---- S6: Reciprocal。对 a+1 求倒数 ----
        // 期望: 1/1, 1/2, 1/3, ...
        Adds<float>(b, a, 1.0f, PR_SLOT);
        PipeBarrier<PIPE_V>();
        Reciprocal<float>(b, b, PR_SLOT);
        PipeBarrier<PIPE_V>();
        DataCopy(out[6 * PR_SLOT], b, PR_SLOT);
        PipeBarrier<PIPE_V>();

        SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
        WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
        DataCopy(yGm, out, PR_OUT);
    }

private:
    TPipe *pipe_;
    GlobalTensor<float> xGm;
    GlobalTensor<float> yGm;
    TBuf<TPosition::VECCALC> bufA;
    TBuf<TPosition::VECCALC> bufB;
    TBuf<TPosition::VECCALC> bufOut;
};

extern "C" __global__ __vector__ void probe_kernel(GM_ADDR x, GM_ADDR y)
{
    if (GetBlockIdx() != 0) {
        return;
    }
    TPipe pipe;
    KernelProbe op(&pipe);
    op.Init(x, y);
    op.Process();
}

// ============================================================================
// 计时探针：把"16 次 strided DataCopyPad 抽平面"重复 R 次，用来量它的真实成本
// 这是 S1 能不能走 SoA 路线的关键数字
// ============================================================================
class KernelGatherCost {
public:
    __aicore__ inline KernelGatherCost(TPipe *pipe) : pipe_(pipe) {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, uint32_t nMats, uint32_t rounds)
    {
        nMats_ = nMats;
        rounds_ = rounds;
        xGm.SetGlobalBuffer((__gm__ float *)x, nMats * PR_MAT);
        yGm.SetGlobalBuffer((__gm__ float *)y, nMats * PR_MAT);
        pipe_->InitBuffer(planeBuf, PR_MAT * PR_TILE_MAX * sizeof(float));
    }

    __aicore__ inline void Process()
    {
        LocalTensor<float> p = planeBuf.Get<float>();
        for (uint32_t r = 0; r < rounds_; r++) {
            DataCopyExtParams par{static_cast<uint16_t>(nMats_),
                                  static_cast<uint32_t>(sizeof(float)),
                                  static_cast<uint32_t>((PR_MAT - 1) * sizeof(float)), 0, 0};
            DataCopyPadExtParams<float> pad{false, 0, 0, 0.0f};
            for (uint32_t k = 0; k < PR_MAT; k++) {
                DataCopyPad(p[k * nMats_], xGm[k], par, pad);
            }
            SetFlag<HardEvent::MTE2_MTE3>(EVENT_ID0);
            WaitFlag<HardEvent::MTE2_MTE3>(EVENT_ID0);
        }
        // 写点东西出去，防止被优化掉
        DataCopy(yGm, p, nMats_ * PR_MAT);
    }

private:
    TPipe *pipe_;
    uint32_t nMats_;
    uint32_t rounds_;
    GlobalTensor<float> xGm;
    GlobalTensor<float> yGm;
    TBuf<TPosition::VECCALC> planeBuf;
};

extern "C" __global__ __vector__ void probe_gather_cost(
    GM_ADDR x, GM_ADDR y, uint32_t nMats, uint32_t rounds)
{
    if (GetBlockIdx() != 0) {
        return;
    }
    TPipe pipe;
    KernelGatherCost op(&pipe);
    op.Init(x, y, nMats, rounds);
    op.Process();
}
