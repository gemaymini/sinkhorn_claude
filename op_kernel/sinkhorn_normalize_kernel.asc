#include "kernel_operator.h"
#include "sinkhorn_normalize_tiling.h"

using namespace AscendC;

constexpr int32_t ONE_BLK_FLOAT = 8;

class KernelSinkhorn {
public:
    __aicore__ inline KernelSinkhorn(TPipe* pipe) : pipe_(pipe) {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR tiling,
                                const __gm__ SinkhornTilingData* t)
    {
        tiling_ = t;
        eps_ = t->eps;
        repeat_ = t->repeat;
        uint32_t blockIdx = GetBlockIdx();
        uint32_t totalMats = t->totalMats;
        uint32_t matPerCore = t->matPerCore;
        matStart_ = blockIdx * matPerCore;
        matEnd_ = (blockIdx == t->blockNum - 1) ? totalMats : matStart_ + matPerCore;
        uint32_t myNumMats = matEnd_ - matStart_;

        xGm.SetGlobalBuffer((__gm__ float*)x + matStart_ * SN_MAT_SIZE, myNumMats * SN_MAT_SIZE);
        yGm.SetGlobalBuffer((__gm__ float*)y + matStart_ * SN_MAT_SIZE, myNumMats * SN_MAT_SIZE);

        pipe_->InitBuffer(inQueueX, 1, SN_UB_IN * sizeof(float));
        pipe_->InitBuffer(outQueueZ, 1, SN_UB_OUT * sizeof(float));
        pipe_->InitBuffer(workBuf, SN_UB_WORK * sizeof(float));
        pipe_->InitBuffer(reduceBuf, SN_UB_REDUCE * sizeof(float));
        pipe_->InitBuffer(bcastBuf, SN_UB_BCAST * sizeof(float));
        pipe_->InitBuffer(tmpBuf, SN_UB_TMP * sizeof(float));
    }

    __aicore__ inline void Process()
    {
        uint32_t myNumMats = matEnd_ - matStart_;
        for (uint32_t i = 0; i < myNumMats; i++) {
            ProcessOneMatrix(i);
        }
    }

private:
    __aicore__ inline void ProcessOneMatrix(uint32_t localIdx)
    {
        CopyIn(localIdx);
        Compute();
        CopyOut(localIdx);
    }

    __aicore__ inline void CopyIn(uint32_t localIdx)
    {
        LocalTensor<float> xLocal = inQueueX.AllocTensor<float>();
        // Load 16 elements with zero padding
        for (uint32_t r = 0; r < SN_MHC; r++) {
            DataCopyPad(xLocal[r * (SN_MHC * 2)], xGm[localIdx * SN_MAT_SIZE + r * SN_MHC],
                {1, static_cast<uint16_t>(SN_MHC * sizeof(float)), 0, 0},
                {true, 0, SN_MHC, 0});
        }
        inQueueX.EnQue(xLocal);
    }

    __aicore__ inline void Compute()
    {
        LocalTensor<float> x = inQueueX.DeQue<float>();
        LocalTensor<float> z = outQueueZ.AllocTensor<float>();

        LocalTensor<float> work = workBuf.Get<float>();
        LocalTensor<float> reduceR = reduceBuf.Get<float>();
        LocalTensor<float> bcast = bcastBuf.Get<float>();
        LocalTensor<float> tmp = tmpBuf.Get<float>();

        DataCopy(z, x, SN_UB_IN);
        PipeBarrier<PIPE_V>();

        // Softmax over rows + eps
        SoftmaxRows(z, work, reduceR, bcast, tmp);
        // z = softmax + eps (padding has 0+eps = eps)
        Adds<float>(z, z, eps_, SN_UB_IN);
        PipeBarrier<PIPE_V>();
        // Zero padding (so subsequent row ops give correct sums)
        ZeroPadding(z);

        // Initial col normalize
        ColNormalize(z, work, tmp, bcast);

        // Iterate
        for (uint32_t it = 0; it < repeat_ - 1; it++) {
            RowNormalize(z, work, reduceR, bcast);
            ColNormalize(z, work, tmp, bcast);
        }

        outQueueZ.EnQue<float>(z);
        inQueueX.FreeTensor(x);
    }

    __aicore__ inline void CopyOut(uint32_t localIdx)
    {
        LocalTensor<float> z = outQueueZ.DeQue<float>();
        for (uint32_t r = 0; r < SN_MHC; r++) {
            DataCopyPad(yGm[localIdx * SN_MAT_SIZE + r * SN_MHC], z[r * (SN_MHC * 2)],
                {1, static_cast<uint16_t>(SN_MHC * sizeof(float)), 0, 0});
        }
        outQueueZ.FreeTensor(z);
    }

    // Zero padding positions using GetValue/SetValue
    __aicore__ inline void ZeroPadding(LocalTensor<float>& x)
    {
        for (uint32_t r = 0; r < SN_MHC; r++) {
            for (uint32_t k = SN_MHC; k < SN_MHC * 2; k++) {
                x.SetValue(r * (SN_MHC * 2) + k, 0.0f);
            }
        }
        SetFlag<HardEvent::S_V>(EVENT_ID0);
        WaitFlag<HardEvent::S_V>(EVENT_ID0);
        SetFlag<HardEvent::V_S>(EVENT_ID0);
        WaitFlag<HardEvent::V_S>(EVENT_ID0);
    }

    __aicore__ inline void SoftmaxRows(LocalTensor<float>& x, LocalTensor<float>& work,
                                        LocalTensor<float>& reduceR, LocalTensor<float>& bcast,
                                        LocalTensor<float>& tmp)
    {
        for (uint32_t r = 0; r < SN_MHC; r++) {
            // 1. Row max (count=8, includes padding=0; for positive inputs, max is correct)
            ReduceMax<float>(reduceR, x[r * (SN_MHC * 2)], work, ONE_BLK_FLOAT, false);
            PipeBarrier<PIPE_V>();
            // 2. Broadcast max
            Brcb<float>(bcast, reduceR, 1, {1, 8});
            PipeBarrier<PIPE_V>();
            // 3. Sub max
            Sub<float>(tmp[r * (SN_MHC * 2)], x[r * (SN_MHC * 2)], bcast, ONE_BLK_FLOAT);
            PipeBarrier<PIPE_V>();
            // 4. Exp
            Exp<float>(x[r * (SN_MHC * 2)], tmp[r * (SN_MHC * 2)], ONE_BLK_FLOAT);
            PipeBarrier<PIPE_V>();
            // 5. Row sum (includes padding = exp(-max))
            ReduceSum<float, true>(reduceR, x[r * (SN_MHC * 2)], work, ONE_BLK_FLOAT);
            PipeBarrier<PIPE_V>();
            // 6. Get sum_8 and padding_value, compute sum_4
            SetFlag<HardEvent::V_S>(EVENT_ID0);
            WaitFlag<HardEvent::V_S>(EVENT_ID0);
            float sum_8 = reduceR.GetValue(0);
            float pad_val = x.GetValue(r * (SN_MHC * 2) + SN_MHC);  // exp(-max)
            float sum_4 = sum_8 - 4.0f * pad_val;
            reduceR.SetValue(0, sum_4);
            SetFlag<HardEvent::S_V>(EVENT_ID0);
            WaitFlag<HardEvent::S_V>(EVENT_ID0);
            // 7. Broadcast sum_4
            Brcb<float>(bcast, reduceR, 1, {1, 8});
            PipeBarrier<PIPE_V>();
            // 8. Div (padding gets 0/sum_4 = 0)
            Div<float>(x[r * (SN_MHC * 2)], x[r * (SN_MHC * 2)], bcast, ONE_BLK_FLOAT);
            PipeBarrier<PIPE_V>();
        }
    }

    __aicore__ inline void RowNormalize(LocalTensor<float>& x, LocalTensor<float>& work,
                                         LocalTensor<float>& reduceR, LocalTensor<float>& bcast)
    {
        for (uint32_t r = 0; r < SN_MHC; r++) {
            // Row sum (padding is 0, sum is correct)
            ReduceSum<float, true>(reduceR, x[r * (SN_MHC * 2)], work, ONE_BLK_FLOAT);
            PipeBarrier<PIPE_V>();
            // Get sum, add eps
            SetFlag<HardEvent::V_S>(EVENT_ID0);
            WaitFlag<HardEvent::V_S>(EVENT_ID0);
            float sum_8 = reduceR.GetValue(0);
            float pad_val = x.GetValue(r * (SN_MHC * 2) + SN_MHC);
            float sum_4 = sum_8 - 4.0f * pad_val;
            reduceR.SetValue(0, sum_4 + eps_);
            SetFlag<HardEvent::S_V>(EVENT_ID0);
            WaitFlag<HardEvent::S_V>(EVENT_ID0);
            Brcb<float>(bcast, reduceR, 1, {1, 8});
            PipeBarrier<PIPE_V>();
            Div<float>(x[r * (SN_MHC * 2)], x[r * (SN_MHC * 2)], bcast, ONE_BLK_FLOAT);
            PipeBarrier<PIPE_V>();
        }
    }

    __aicore__ inline void ColNormalize(LocalTensor<float>& x, LocalTensor<float>& work,
                                         LocalTensor<float>& tmp, LocalTensor<float>& bcast)
    {
        // 1. Compute col sums at tmp[0..3] (tmp[4..7] = padding sums = 0)
        Add<float>(tmp, x, x[ONE_BLK_FLOAT], ONE_BLK_FLOAT);
        PipeBarrier<PIPE_V>();
        Add<float>(tmp, tmp, x[ONE_BLK_FLOAT * 2], ONE_BLK_FLOAT);
        PipeBarrier<PIPE_V>();
        Add<float>(tmp, tmp, x[ONE_BLK_FLOAT * 3], ONE_BLK_FLOAT);
        PipeBarrier<PIPE_V>();
        // 2. Add eps to all 8: tmp[0..3] = col_sum + eps, tmp[4..7] = eps
        Adds<float>(tmp, tmp, eps_, ONE_BLK_FLOAT);
        PipeBarrier<PIPE_V>();
        // 3. Build divisor: copy tmp[0..7] to each row group of bcast
        for (uint32_t r = 0; r < SN_MHC; r++) {
            DataCopy<float>(bcast[r * (SN_MHC * 2)], tmp, SN_MHC * 2);
        }
        PipeBarrier<PIPE_V>();
        // 4. Div: valid /= col_sum + eps, padding /= eps (= 0/eps = 0)
        Div<float>(x, x, bcast, SN_UB_IN);
        PipeBarrier<PIPE_V>();
    }

private:
    TPipe* pipe_;
    const __gm__ SinkhornTilingData* tiling_;
    float eps_;
    uint32_t repeat_;
    uint32_t matStart_;
    uint32_t matEnd_;

    GlobalTensor<float> xGm;
    GlobalTensor<float> yGm;

    TQue<TPosition::VECIN, 1> inQueueX;
    TQue<TPosition::VECOUT, 1> outQueueZ;
    TBuf<TPosition::VECCALC> workBuf;
    TBuf<TPosition::VECCALC> reduceBuf;
    TBuf<TPosition::VECCALC> bcastBuf;
    TBuf<TPosition::VECCALC> tmpBuf;
};

extern "C" __global__ __vector__ void sinkhorn_normalize_kernel(
    GM_ADDR x, GM_ADDR y, GM_ADDR tiling)
{
    TPipe pipe;
    KernelSinkhorn op(&pipe);
    op.Init(x, y, tiling, (__gm__ SinkhornTilingData*)tiling);
    op.Process();
}
