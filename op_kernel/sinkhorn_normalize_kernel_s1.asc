 * SPDX-License-Identifier: CANN Open Software License Agreement Version 2.0
 *
 * ============================================================================
 * SinkhornNormalize S1 —— padded-AoS 批量向量化
 * ============================================================================
 *
 * 相对原实现（每次处理 1 个矩阵、每矩阵 ~228 条向量指令 + ~198 个 PipeBarrier
 * + ~82 对标量↔向量同步）的三处结构性改动：
 *
 *   1. 批量化：一个 tile 一次处理 B 个矩阵，所有向量指令的 repeatTimes 都是 B 量级，
 *      矩阵之间不再有 barrier。
 *   2. 消除全部标量操作：没有 GetValue/SetValue，没有 V_S/S_V 同步。
 *      原实现需要标量修正是因为填充位污染了归约；这里靠 CopyIn 的 paddingValue=-1000
 *      让 exp 下溢成精确的 0，填充位在 10 次迭代中恒为 0，归约天然正确。
 *   3. 算法归一化：softmax 就是 Exp + 一次行归一，整个算法塌缩成
 *          Exp → RowNorm(=softmax) → +eps → ColNorm → 9 × (RowNorm, ColNorm)
 *      严格交替，没有特例分支。
 *
 * eps 全部保留（不做数值近似）。`softmax + eps` 这一项本地仿真验证过不能省：
 * 输入幅值到 randn×4 时裕度占用会从 0.0009 飙到 15.9。保留全部 eps 后裕度是 0.0000。
 * eps 只能加在有效位、填充位必须保持 0，做法是把 tiling buffer 尾部的 eps 数组
 * 用 DataCopyPad+rightPadding 展开成 [eps,eps,eps,eps,0,0,0,0]，每 tile 一次 Add。
 *
 * 唯一的数值偏离是 softmax 免减 max（省掉 BlockReduceMax+Brcb+Sub）。
 * 官方输入 max|x|≈4.75，exp 最大 115，距 fp32 上限 3.4e38 有 36 个数量级余量。
 *
 * UB 布局（每矩阵 32 个 float = 4 行 × 8，每行 4 个有效 + 4 个填充）：
 *
 *      z[32m + 8r + c]   c<4 : 矩阵 m 第 r 行第 c 列
 *                        c>=4: 填充，恒为 0
 *
 * 用到的 AscendC 原语全部已由 probe 或现有 kernel 验证：
 *   DataCopyPad + rightPadding  —— probe S2 确认
 *   BlockReduceSum 结果连续      —— probe S3 确认
 *   Reciprocal                  —— probe S6 确认
 *   Brcb                        —— 现有 kernel 中已在正确工作
 */

#include "kernel_operator.h"
#include "sinkhorn_normalize_tiling.h"

using namespace AscendC;

// CopyOut 方式：0 = 单次批量 DataCopyPad（快，默认）
//               1 = 每行一次，共 4 次/tile（保守回退）
#ifndef SN_S1_COPYOUT_MODE
#define SN_S1_COPYOUT_MODE 0
#endif

// 除法实现：0 = Reciprocal + Newton-Raphson 修正 + Mul（默认，快）
//           1 = 直接 Div（精度最高，但 Div 吞吐低于 Mul）
// 实测 AscendC 的 Reciprocal 只有约 9~10 位有效精度，裸用会让最终误差到 1e-3 量级。
// NR 迭代 r <- r*(2 - a*r) 每步把有效位数翻倍，而且只作用在很小的和向量上
// （nE*4 / nE*8 个元素，相比主运算的 nE*32 可忽略）。
#ifndef SN_S1_DIV_MODE
#define SN_S1_DIV_MODE 0
#endif
#ifndef SN_S1_NR_STEPS
#define SN_S1_NR_STEPS 2
#endif

// softmax 是否减去行最大值。
// 免减 max 在官方输入（max|x|≈4.75）下数学上没问题，但实测大幅值输入（randn×8，
// exp 到 1.4e12）会整体失效，说明硬件的 Exp/Reciprocal 在极端量级下不可靠。
// 减 max 后 exp 输入恒 <= 0、exp 值落在 (0,1]、行和落在 (0,4]，彻底消除极端量级。
// 代价是每 tile 3 条指令（不在迭代循环内）。
#ifndef SN_S1_USE_MAX
#define SN_S1_USE_MAX 1
#endif

// ColNormalize 的向量化宽度：
//   0 = 每个 repeat 处理 1 个矩阵（mask=8，64 个 lane 里只用 8 个，浪费 8 倍）
//   1 = 每个 repeat 处理 8 个矩阵（mask=64 + blkStride=4），默认
// 矩阵 m 占 block 4m..4m+3，所以让 repeat 内的 8 个 block 以 blkStride=4 前进，
// 正好落在矩阵 8j+0..8j+7 的同一行上。
// nE=64 时 ColNormalize 从 456 个 repeat 降到 64 个，占整体 82% 的开销减少 7 倍。
#ifndef SN_S1_COLNORM_WIDE
#define SN_S1_COLNORM_WIDE 1
#endif

// 向量指令之间的 PipeBarrier<PIPE_V> 策略：
//   0 = 每条向量指令后都插（原写法，沿袭自 v0）
//   1 = 全部去掉，只保留跨 pipe 的 SetFlag/WaitFlag
//
// PipeBarrier<PIPE_V> 排序的是**同一个 V pipe 内**的指令，而向量指令本来就在
// V pipe 上按序发射；跨 pipe（MTE2->V, V->MTE3）的依赖另有 SetFlag/WaitFlag 处理。
// S1b 实测发现：把 ColNormalize 的 repeat 数降低 7 倍，kernel 时间纹丝不动，
// 说明瓶颈不是 lane 利用率而是每条指令的固定开销 —— 每 tile 约 124 条指令配 120 个
// barrier，每个 barrier 都要排空整条向量流水线。这个开关就是用来验证这一点的。
// 正确性由 scripts/check_shapes.py 的精度门禁把关。
#ifndef SN_S1_BARRIER_MODE
#define SN_S1_BARRIER_MODE 0
#endif

// 诊断开关（结果不正确，只用于计时，精度门禁会跳过）：
//   1 = 只做 CopyIn + CopyOut，跳过全部计算 —— 量纯 MTE 搬运的时间下界
//   2 = 额外跳过 BuildEpsVector —— 量它单独值多少
// 迭代次数扫描显示每 tile 固定开销占 95%，这两个开关用来定位它到底在哪。
#ifndef SN_S1_DIAG
#define SN_S1_DIAG 0
#endif

#if SN_S1_BARRIER_MODE == 0
#define SN_VBAR() PipeBarrier<PIPE_V>()
#else
#define SN_VBAR() ((void)0)
#endif

namespace {
constexpr uint32_t BLK = 8;                 // 一个 32B block 装 8 个 fp32
constexpr uint32_t ROW_BYTES = SN_MHC * sizeof(float);   // 16B，一行有效数据
}

class KernelSinkhornS1 {
public:
    __aicore__ inline KernelSinkhornS1(TPipe *pipe) : pipe_(pipe) {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR tiling,
                                const __gm__ SinkhornTilingData *t)
    {
        repeat_ = t->repeat;
        eps_ = t->eps;
        // 列和里填充列恒为 0，除数必须非零；eps 若为 0 则退回一个极小量
        colEps_ = eps_ > SN_TINY ? eps_ : SN_TINY;
        tile_ = t->matsPerTile;
        if (tile_ == 0 || tile_ > SN_TILE_MAX) {
            tile_ = SN_TILE_MAX;
        }

        const uint32_t blockIdx = GetBlockIdx();
        const uint32_t matPerCore = t->matPerCore;
        matStart_ = blockIdx * matPerCore;
        matEnd_ = matStart_ + matPerCore;
        if (matEnd_ > t->totalMats) {
            matEnd_ = t->totalMats;
        }
        if (matStart_ > t->totalMats) {
            matStart_ = t->totalMats;
        }

        const uint32_t myMats = matEnd_ - matStart_;
        xGm.SetGlobalBuffer((__gm__ float *)x + matStart_ * SN_MAT_SIZE, myMats * SN_MAT_SIZE);
        yGm.SetGlobalBuffer((__gm__ float *)y + matStart_ * SN_MAT_SIZE, myMats * SN_MAT_SIZE);

        // tiling buffer 尾部附带的 eps 数组（SN_EPSVEC_LEN 个 float，全为 eps）
        epsGm.SetGlobalBuffer((__gm__ float *)tiling + SN_EPSVEC_OFFSET, SN_EPSVEC_LEN);

        pipe_->InitBuffer(zBuf, SN_TILE_MAX * SN_PAD_MAT * sizeof(float));
        pipe_->InitBuffer(bcastBuf, SN_TILE_MAX * SN_PAD_MAT * sizeof(float));
        pipe_->InitBuffer(epsBuf, SN_TILE_MAX * SN_PAD_MAT * sizeof(float));
        pipe_->InitBuffer(rowBuf, SN_TILE_MAX * SN_MHC * sizeof(float));
        pipe_->InitBuffer(colBuf, SN_TILE_MAX * BLK * sizeof(float));
        // 倒数结果 + NR 迭代临时量，各 SN_TILE_MAX*BLK
        pipe_->InitBuffer(recBuf, SN_TILE_MAX * BLK * 2 * sizeof(float));

#if SN_S1_DIAG != 2
        BuildEpsVector();
#endif
    }

    // 一次性：把 tile_*4 个 eps 展开成 [eps,eps,eps,eps,0,0,0,0] 重复的向量。
    // 用 tile_ 而不是 SN_TILE_MAX —— 后者写死 128，tile 只有 64 时会白搬一半的
    // MTE 描述符，而每 tile 固定开销正是当前的主要瓶颈。
    __aicore__ inline void BuildEpsVector()
    {
        LocalTensor<float> epsPad = epsBuf.Get<float>();
        DataCopyExtParams params;
        params.blockCount = static_cast<uint16_t>(tile_ * SN_MHC);
        params.blockLen = static_cast<uint32_t>(ROW_BYTES);
        params.srcStride = 0;
        params.dstStride = 0;
        DataCopyPadExtParams<float> pad{true, 0, SN_MHC, 0.0f};
        DataCopyPad(epsPad, epsGm, params, pad);
        SetFlag<HardEvent::MTE2_V>(EVENT_ID1);
        WaitFlag<HardEvent::MTE2_V>(EVENT_ID1);
    }

    __aicore__ inline void Process()
    {
        const uint32_t myMats = matEnd_ - matStart_;
        for (uint32_t off = 0; off < myMats; off += tile_) {
            uint32_t n = myMats - off;
            if (n > tile_) {
                n = tile_;
            }
            ProcessTile(off, n);
        }
    }

private:
    // ------------------------------------------------------------------
    // r = 1/a，用 Newton-Raphson 把硬件 Reciprocal 的 ~9 位精度提到 fp32 级
    //   r <- r * (2 - a*r)，每步有效位数翻倍
    // ------------------------------------------------------------------
    __aicore__ inline void ReciprocalNR(LocalTensor<float> r, LocalTensor<float> t,
                                        LocalTensor<float> a, uint32_t count)
    {
        Reciprocal<float>(r, a, count);
        SN_VBAR();
        for (uint32_t i = 0; i < SN_S1_NR_STEPS; i++) {
            Mul<float>(t, a, r, count);
            SN_VBAR();
            Muls<float>(t, t, -1.0f, count);
            SN_VBAR();
            Adds<float>(t, t, 2.0f, count);
            SN_VBAR();
            Mul<float>(r, r, t, count);
            SN_VBAR();
        }
    }

    // ------------------------------------------------------------------
    // 一个 tile：n 个矩阵
    // ------------------------------------------------------------------
    __aicore__ inline void ProcessTile(uint32_t matOff, uint32_t n)
    {
        LocalTensor<float> z = zBuf.Get<float>();

        // 对齐到 8 的倍数：BlockReduceSum 需要偶数，宽 ColNormalize 需要 8 的倍数。
        // SN_TILE_MAX 是 8 的倍数，所以向上取整不会越过缓冲区。
        const uint32_t nE = (n + 7U) & ~7U;

        CopyIn(z, matOff, n);

#if SN_S1_DIAG == 1
        // 诊断：只搬运，不计算。结果不正确，只用于量 MTE 的时间下界。
        CopyOut(z, matOff, n);
        return;
#endif

        if (nE > n) {
            // 尾部补齐的那个矩阵填 0，Exp 后为 1，全程保持有限，且不会被写回
            Duplicate<float>(z[n * SN_PAD_MAT], 0.0f, (nE - n) * SN_PAD_MAT);
            SN_VBAR();
        }

#if SN_S1_USE_MAX
        // 减去行最大值：填充位是 -1000，永远不会成为最大值；减完仍远小于 -100，
        // exp 后依旧是精确的 0。
        {
            LocalTensor<float> rowMax = rowBuf.Get<float>();
            LocalTensor<float> bcast = bcastBuf.Get<float>();
            BlockReduceMax<float>(rowMax, z, static_cast<uint8_t>(nE / 2), 64, 1, 1, BLK);
            SN_VBAR();
            Brcb<float>(bcast, rowMax, static_cast<uint8_t>(nE / 2), {1, BLK});
            SN_VBAR();
            Sub<float>(z, z, bcast, nE * SN_PAD_MAT);
            SN_VBAR();
        }
#endif

        // 填充位 = exp(很负) = 0（精确），此后 10 次迭代中恒为 0
        Exp<float>(z, z, nE * SN_PAD_MAT);
        SN_VBAR();

        // 第一次 RowNormalize 就是 softmax（分母不带 eps，与参考实现一致）
        RowNormalize(z, nE, 0.0f);

        // x = softmax(x) + eps —— 只加在有效位，填充位加 0 仍为 0
        {
            LocalTensor<float> epsPad = epsBuf.Get<float>();
            Add<float>(z, z, epsPad, nE * SN_PAD_MAT);
            SN_VBAR();
        }

        ColNormalize(z, nE);
        for (uint32_t it = 1; it < repeat_; it++) {
            RowNormalize(z, nE, eps_);
            ColNormalize(z, nE);
        }

        CopyOut(z, matOff, n);
    }

    // ------------------------------------------------------------------
    // CopyIn: n*4 行，每行 16B，右补 4 个 SN_PAD_FILL。一次调用搞定整个 tile。
    // ------------------------------------------------------------------
    __aicore__ inline void CopyIn(LocalTensor<float> &z, uint32_t matOff, uint32_t n)
    {
        DataCopyExtParams params;
        params.blockCount = static_cast<uint16_t>(n * SN_MHC);
        params.blockLen = static_cast<uint32_t>(ROW_BYTES);
        params.srcStride = 0;
        params.dstStride = 0;
        DataCopyPadExtParams<float> pad{true, 0, SN_MHC, SN_PAD_FILL};
        DataCopyPad(z, xGm[matOff * SN_MAT_SIZE], params, pad);

        SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
        WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
    }

    // ------------------------------------------------------------------
    // RowNormalize: z /= 行和。4 条指令覆盖整个 tile，无标量、无 mask。
    //   行和 = BlockReduceSum（填充位为 0，8 个之和即 4 个有效值之和）
    // ------------------------------------------------------------------
    __aicore__ inline void RowNormalize(LocalTensor<float> &z, uint32_t nE, float denomEps)
    {
        LocalTensor<float> rowSum = rowBuf.Get<float>();
        LocalTensor<float> bcast = bcastBuf.Get<float>();

        // nE*32 个 float = nE/2 个 repeat，每 repeat 出 8 个和，连续写入
        BlockReduceSum<float>(rowSum, z, static_cast<uint8_t>(nE / 2), 64, 1, 1, BLK);
        SN_VBAR();

        // 参考实现是 x / (rowsum + eps)；softmax 那一次传 0
        Adds<float>(rowSum, rowSum, denomEps, nE * SN_MHC);
        SN_VBAR();

#if SN_S1_DIV_MODE == 0
        // 全部元素来自 exp，恒为正，行和不可能为 0
        LocalTensor<float> rec = recBuf.Get<float>();
        ReciprocalNR(rec, rec[SN_TILE_MAX * BLK], rowSum, nE * SN_MHC);
        Brcb<float>(bcast, rec, static_cast<uint8_t>(nE / 2), {1, BLK});
        SN_VBAR();
        Mul<float>(z, z, bcast, nE * SN_PAD_MAT);
        SN_VBAR();
#else
        Brcb<float>(bcast, rowSum, static_cast<uint8_t>(nE / 2), {1, BLK});
        SN_VBAR();
        Div<float>(z, z, bcast, nE * SN_PAD_MAT);
        SN_VBAR();
#endif
    }

    // ------------------------------------------------------------------
    // ColNormalize: z /= 列和。
    //   列和 = 同一矩阵 4 个行组按 32B block 对齐相加（3 条带 stride 的 Add）。
    //   矩阵 m 的行 r 位于 block (4m + r)，故 src 的 repeat stride = 4 blocks。
    // ------------------------------------------------------------------
    __aicore__ inline void ColNormalize(LocalTensor<float> &z, uint32_t nE)
    {
        LocalTensor<float> colSum = colBuf.Get<float>();

#if SN_S1_COLNORM_WIDE
        // 一个 repeat 吃 8 个矩阵：mask=64 覆盖 8 个 block，blkStride=4 让这 8 个 block
        // 落在矩阵 8j+0..8j+7 的同一行上；repStride=32 每个 repeat 跨过 8 个矩阵。
        const uint64_t cmask = 64;
        const uint8_t crep = static_cast<uint8_t>(nE / 8);
        const BinaryRepeatParams pSum0{1, 4, 4, 8, 32, 32};   // colSum = z[r0] + z[r1]
        const BinaryRepeatParams pSum1{1, 1, 4, 8, 8, 32};    // colSum += z[r2] / z[r3]
        const BinaryRepeatParams pApply{4, 4, 1, 32, 32, 8};  // z[rk] *= colRecip
#else
        // 一个 repeat 一个矩阵（对照）
        const uint64_t cmask = BLK;
        const uint8_t crep = static_cast<uint8_t>(nE);
        const BinaryRepeatParams pSum0{1, 1, 1, 1, 4, 4};
        const BinaryRepeatParams pSum1{1, 1, 1, 1, 1, 4};
        const BinaryRepeatParams pApply{1, 1, 1, 4, 4, 1};
#endif

        // colSum[8m..8m+8) = z[32m..] + z[32m+8..] + z[32m+16..] + z[32m+24..]
        Add<float>(colSum, z, z[BLK], cmask, crep, pSum0);
        SN_VBAR();
        Add<float>(colSum, colSum, z[BLK * 2], cmask, crep, pSum1);
        SN_VBAR();
        Add<float>(colSum, colSum, z[BLK * 3], cmask, crep, pSum1);
        SN_VBAR();

        // 参考实现是 x / (colsum + eps)。填充列的和恒为 0，加 eps 后取倒数得有限值，
        // 乘上恒为 0 的填充值仍是 0，不会产生 inf/NaN。
        Adds<float>(colSum, colSum, colEps_, nE * BLK);
        SN_VBAR();

        // 同一个列向量作用到 4 个行组
#if SN_S1_DIV_MODE == 0
        LocalTensor<float> rec = recBuf.Get<float>();
        ReciprocalNR(rec, rec[SN_TILE_MAX * BLK], colSum, nE * BLK);
        for (uint32_t r = 0; r < SN_MHC; r++) {
            Mul<float>(z[BLK * r], z[BLK * r], rec, cmask, crep, pApply);
            SN_VBAR();
        }
#else
        for (uint32_t r = 0; r < SN_MHC; r++) {
            Div<float>(z[BLK * r], z[BLK * r], colSum, cmask, crep, pApply);
            SN_VBAR();
        }
#endif
    }

    // ------------------------------------------------------------------
    // CopyOut: 从每个 32B block 取前 16B 写回 GM
    // ------------------------------------------------------------------
    __aicore__ inline void CopyOut(LocalTensor<float> &z, uint32_t matOff, uint32_t n)
    {
        SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
        WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);

#if SN_S1_COPYOUT_MODE == 0
        // 批量：n*4 个 block，每个取前 16B
        DataCopyExtParams params;
        params.blockCount = static_cast<uint16_t>(n * SN_MHC);
        params.blockLen = static_cast<uint32_t>(ROW_BYTES);
        params.srcStride = 0;
        params.dstStride = 0;
        DataCopyPad(yGm[matOff * SN_MAT_SIZE], z, params);
#else
        // 保守回退：每个行号一次调用，共 4 次/tile
        for (uint32_t r = 0; r < SN_MHC; r++) {
            DataCopyExtParams params;
            params.blockCount = static_cast<uint16_t>(n);
            params.blockLen = static_cast<uint32_t>(ROW_BYTES);
            params.srcStride = 3;                                    // 跳过 3 个 32B block
            params.dstStride = (SN_MAT_SIZE - SN_MHC) * sizeof(float);  // 48B
            DataCopyPad(yGm[matOff * SN_MAT_SIZE + r * SN_MHC], z[BLK * r], params);
        }
#endif

        SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
        WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
    }

private:
    TPipe *pipe_;
    uint32_t repeat_ = SN_REPEAT;
    float eps_ = SN_EPS;
    float colEps_ = SN_EPS;
    uint32_t tile_ = SN_TILE_MAX;
    uint32_t matStart_ = 0;
    uint32_t matEnd_ = 0;

    GlobalTensor<float> xGm;
    GlobalTensor<float> yGm;
    GlobalTensor<float> epsGm;

    TBuf<TPosition::VECCALC> zBuf;
    TBuf<TPosition::VECCALC> bcastBuf;
    TBuf<TPosition::VECCALC> epsBuf;
    TBuf<TPosition::VECCALC> rowBuf;
    TBuf<TPosition::VECCALC> colBuf;
    TBuf<TPosition::VECCALC> recBuf;
};

extern "C" __global__ __vector__ void sinkhorn_normalize_kernel(
    GM_ADDR x, GM_ADDR y, GM_ADDR tiling)
{
    TPipe pipe;
    KernelSinkhornS1 op(&pipe);
    op.Init(x, y, tiling, (__gm__ SinkhornTilingData *)tiling);
    op.Process();
}
